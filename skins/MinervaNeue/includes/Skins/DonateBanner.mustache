<div class="donate-banner">
	<a href="{{href}}" class="donate-banner__link"
		data-event-name="menu.donateBanner">
		<div class="donate-banner__text-container">
			<span class="donate-banner__text">{{msg-skin-minerva-donate-banner-message}}</span>
			<span class="donate-banner__subtitle">{{msg-skin-minerva-donate-banner-subtitle}}</span>
		</div>
		{{#data-image}}
		<picture>
			<source
				srcset="{{reduced-motion-srcset}}"
				media="(prefers-reduced-motion)" />
			<img src="{{gif-src}}" alt="" class="donate-banner__gif" loading="lazy">
		</picture>
		{{/data-image}}
	</a>
</div>
